# --- Session ---
# Generar con: openssl rand -base64 32
SESSION_SECRET=change-me

# --- Seed ---
SEED_ADMIN_MAIL=admin@onaks.local
SEED_ADMIN_PASSWORD=admin
# Datos de demo (catálogo, clientes, pedidos; usuarios *@demo.onaks.local con
# contraseña demo1234). Solo para probar: se cargan en una base sin productos y
# nunca con NODE_ENV=production. En producción, dejarlo en false.
SEED_DEMO=false

# --- Postgres ---
DATABASE_URL=postgresql://onaks:admin@localhost:5432/onaks?schema=public
POSTGRES_USER=onaks
POSTGRES_PASSWORD=admin
POSTGRES_DB=onaks
POSTGRES_PORT=5432

# --- App ---
APP_PORT=3000
# Idioma de la instalación: es (default) | en. Se lee al arrancar cada request,
# no hace falta rebuildear la imagen para cambiarlo.
APP_LOCALE=es
# Dónde se guardan las imágenes de productos (en Docker ya viene en /app/uploads).
UPLOADS_DIR=uploads
