# --- Session ---
# Generar con: openssl rand -base64 32
SESSION_SECRET=change-me

# --- Seed ---
SEED_ADMIN_MAIL=admin@onaks.local
SEED_ADMIN_PASSWORD=admin
# Datos de demo (catálogo, clientes, pedidos; usuarios *@demo.onaks.local con
# contraseña demo1234). Solo para probar: se cargan en una base sin productos y
# nunca con NODE_ENV=production. En producción, dejarlo en false.
SEED_DEMO=false

# --- Postgres ---
DATABASE_URL=postgresql://onaks:admin@localhost:5432/onaks?schema=public
POSTGRES_USER=onaks
POSTGRES_PASSWORD=admin
POSTGRES_DB=onaks
POSTGRES_PORT=5432

# --- App ---
APP_PORT=3000
# Idioma de la instalación: es (default) | en. Se lee al arrancar cada request,
# no hace falta rebuildear la imagen para cambiarlo.
APP_LOCALE=es
# Dónde se guardan las imágenes de productos (en Docker ya viene en /app/uploads).
UPLOADS_DIR=uploads

# --- Producción (docker-compose.prod.yml, ver docs/instalacion.md) ---
# Versión publicada de la app (tag de GHCR, ej. 1.40.0-beta).
APP_VERSION=
# APP_IMAGE=ghcr.io/santiabe04/onaks_system
# Dominio que apunta al servidor, sin https:// (ej. pedidos.tudistribuidora.com.ar).
DOMAIN=
# Mail para los avisos del certificado (Let's Encrypt/ZeroSSL).
ACME_EMAIL=
# Certificado: auto (Caddy lo saca y renueva solo) | custom (archivos en ./certs)
# | proxy (el HTTPS lo termina el proveedor y llega por HTTP).
TLS_MODE=auto
# Solo con TLS_MODE=proxy: IPs o rangos del proxy del proveedor.
# TRUSTED_PROXIES=private_ranges
# Backups automáticos: carpeta del servidor, días que se guardan y hora del día.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
