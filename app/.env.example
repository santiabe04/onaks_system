# --- Session ---
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# --- Seed ---
SEED_ADMIN_MAIL=admin@onaks.local
SEED_ADMIN_PASSWORD=admin
# Demo data (catalog, customers, orders; users *@demo.onaks.local with
# password demo1234). For trying things out only: it is loaded into a database with no products and
# never with NODE_ENV=production. In production, leave it as false.
SEED_DEMO=false

# --- Postgres ---
DATABASE_URL=postgresql://onaks:admin@localhost:5432/onaks?schema=public
POSTGRES_USER=onaks
POSTGRES_PASSWORD=admin
POSTGRES_DB=onaks
POSTGRES_PORT=5432

# --- App ---
APP_PORT=3000
# Installation language: es (default) | en. It is read on every request at startup,
# so the image does not need to be rebuilt to change it.
APP_LOCALE=es
# Emails to the customer about their order (confirmed, being prepared, out for delivery, delivered).
# Without SMTP_HOST and SMTP_FROM the app works the same and sends nothing.
# SMTP_HOST=
# SMTP_PORT=587
# Port 465 uses direct TLS; on the other ports STARTTLS is negotiated. It can be forced with SMTP_SECURE=true|false.
# SMTP_USER=
# SMTP_PASSWORD=
# Sender, e.g.: My Distributor <pedidos@midistribuidora.com.ar>
# SMTP_FROM=
# Where product images are stored (in Docker it is already /app/uploads).
UPLOADS_DIR=uploads

# --- Production (docker-compose.prod.yml, see docs/instalacion.md) ---
# Published version of the app (GHCR tag, e.g. 1.40.0-beta).
APP_VERSION=
# APP_IMAGE=ghcr.io/santiabe04/onaks_system
# Domain pointing to the server, without https:// (e.g. orders.yourdistributor.com).
DOMAIN=
# Email for the certificate notices (Let's Encrypt/ZeroSSL).
ACME_EMAIL=
# Certificate: auto (Caddy gets it and renews it by itself) | custom (files in ./certs)
# | proxy (HTTPS is terminated by the provider and arrives over HTTP).
TLS_MODE=auto
# Only with TLS_MODE=proxy: IPs or ranges of the provider's proxy.
# TRUSTED_PROXIES=private_ranges
# Automatic backups: server folder, days to keep, and time of day.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
