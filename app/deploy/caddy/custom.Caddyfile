# TLS_MODE=custom: your own certificate (bought or downloaded from the provider) in
# ./certs on the server, in PEM format: fullchain.pem (the certificate + intermediates)
# and privkey.pem. Caddy does not renew it: after replacing the files, reload Caddy
# (see docs/en/installation.md).
{
	auto_https disable_certs
}

{$DOMAIN} {
	tls /certs/fullchain.pem /certs/privkey.pem
	import /etc/caddy/app.caddy
}
