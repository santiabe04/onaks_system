# TLS_MODE=proxy: HTTPS is terminated by the provider's proxy or load balancer and
# traffic arrives over HTTP. Caddy does not handle certificates and trusts that proxy
# (TRUSTED_PROXIES, private networks by default) to take the client's real IP
# from X-Forwarded-For.
{
	auto_https off
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

:80 {
	import /etc/caddy/app.caddy
}
