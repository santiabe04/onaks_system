generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserType {
  ADMIN
  CLIENT
}

enum TaxCondition {
  REGISTERED_TAXPAYER
  SINGLE_TAX_REGIME
  EXEMPT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum SaleState {
  PENDING
  PREPARING
  READY_TO_SHIP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
  FINISHED
}

enum SalePaymentState {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

// Manuales: ENTRY, ADJUSTMENT, WRITE_OFF y la transferencia (un par OUT/IN).
// SALE la generan los pedidos (fase 4).
enum StockMovementType {
  ENTRY
  ADJUSTMENT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  SALE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_LOCKED
  LOGOUT
  PASSWORD_CHANGE
  ACCESS_DENIED
}

enum AuditEntity {
  MEASUREMENT_UNIT
  CATEGORY
  WAREHOUSE
  TAX_RATE
  STOCK_MOVEMENT
  STATE
  CITY
  SUPPLIER
  SUPPLIER_PRODUCT
  PRODUCT
  CUSTOMER
  PERSON
  PERSON_ADDRESS
  USER
  DISCOUNT
  SALE
}

// --- TABLES ---

model MeasurementUnit {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Null en lo que carga el seed.
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdBy   User?     @relation("MeasurementUnitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("MeasurementUnitUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products    Product[]

  @@map("measurement_units")
}

// Árbol de hasta 3 niveles (el límite lo controla la app). El nombre es único
// entre hermanas, también en la raíz (índice NULLS NOT DISTINCT en la migración).
model Category {
  id          Int        @id @default(autoincrement())
  name        String
  parentId    Int?       @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by")
  updatedById String?    @map("updated_by")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  createdBy   User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([parentId, name])
  @@index([parentId], map: "idx_categories_parent_id")
  @@map("categories")
}

// Depósitos de mercadería, con stock propio (ProductStock). Inactivo: no recibe
// movimientos nuevos, pero se conserva para el historial. Solo se desactiva sin stock.
model Warehouse {
  id             String          @id @default(cuid(2))
  name           String          @unique
  address        String
  cityId         Int             @map("city_id")
  phone          String?
  contactName    String?         @map("contact_name")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?         @map("created_by")
  updatedById    String?         @map("updated_by")
  city           City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy      User?           @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?           @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  stocks         ProductStock[]
  stockMovements StockMovement[]

  @@index([cityId], map: "idx_warehouses_city_id")
  @@map("warehouses")
}

// Alícuotas de IVA, como fracción (0.21). Cambiar una tasa afecta a todos los
// productos que la usan; los pedidos ya hechos guardan la del momento.
model TaxRate {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  rate        Decimal   @db.Decimal(5, 4)
  // Inactiva: no se ofrece para productos nuevos, pero sigue valiendo para los que la usan.
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdBy   User?     @relation("TaxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("TaxRateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products    Product[]

  @@map("tax_rates")
}

model Product {
  id                String            @id @default(cuid(2))
  name              String            @unique
  // Código interno, obligatorio. El de barras es opcional (no todo tiene EAN).
  sku               String            @unique
  barcode           String?           @unique
  description       String?
  // Solo categorías finales (sin hijas): lo controla la app.
  categoryId        Int               @map("category_id")
  // Precio neto, sin IVA. El final se calcula con la alícuota.
  price             Decimal           @db.Decimal(12, 2)
  taxRateId         Int               @map("tax_rate_id")
  measurementUnitId Int               @map("measurement_unit_id")
  // Peso en kg y volumen en litros, por unidad de venta.
  weight            Decimal           @db.Decimal(10, 3)
  volume            Decimal?          @db.Decimal(10, 3)
  // Archivo WebP en UPLOADS_DIR/products (ver lib/product-image).
  imageFile         String?           @map("image_file")
  // Pausado: no se ve en el catálogo, pero conserva historial y stock.
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdById       String?           @map("created_by")
  updatedById       String?           @map("updated_by")
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  measurementUnit   MeasurementUnit   @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  taxRate           TaxRate           @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  createdBy         User?             @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?             @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  saleItems         SaleItem[]
  stocks            ProductStock[]
  suppliers         SupplierProduct[]
  stockMovements    StockMovement[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([measurementUnitId], map: "idx_products_measurement_unit_id")
  @@index([taxRateId], map: "idx_products_tax_rate_id")
  @@index([deletedAt], map: "idx_products_deleted_at")
  @@map("products")
}

// Saldo actual por producto y depósito. Se mueve solo a través de un
// StockMovement (en la misma transacción). Puede ser negativo.
model ProductStock {
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@index([warehouseId], map: "idx_product_stocks_warehouse_id")
  @@map("product_stocks")
}

// Libro de movimientos: solo se inserta (trigger en la DB). quantity es la
// variación con signo y alanceAfter el saldo que quedó en ese depósito.
model StockMovement {
  id           String            @id @default(cuid(2))
  productId    String            @map("product_id")
  warehouseId  String            @map("warehouse_id")
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3)
  balanceAfter Decimal           @map("balance_after") @db.Decimal(12, 3)
  comment      String?
  // Agrupa las dos patas de una transferencia.
  transferId   String?           @map("transfer_id")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?           @map("created_by")
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt], map: "idx_stock_movements_product_id_created_at")
  @@index([warehouseId, createdAt], map: "idx_stock_movements_warehouse_id_created_at")
  @@index([transferId], map: "idx_stock_movements_transfer_id")
  @@map("stock_movements")
}

// Proveedores. Inactivo: no se ofrece para compras nuevas, pero se conserva.
// Dirección y localidad van juntas o ninguna de las dos (lo controla la app).
model Supplier {
  id           String            @id @default(cuid(2))
  legalName    String            @map("legal_name")
  tradeName    String?           @map("trade_name")
  cuit         String            @unique @db.VarChar(11)
  taxCondition TaxCondition      @map("tax_condition")
  contactName  String?           @map("contact_name")
  contactMail  String?           @map("contact_mail")
  contactPhone String?           @map("contact_phone")
  address      String?
  cityId       Int?              @map("city_id")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?           @map("created_by")
  updatedById  String?           @map("updated_by")
  city         City?             @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy    User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?             @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products     SupplierProduct[]

  @@index([cityId], map: "idx_suppliers_city_id")
  @@map("suppliers")
}

// Qué productos le compramos a cada proveedor. El costo es neto (sin IVA): por
// ahora se carga a mano; con las órdenes de compra (fase 9) se actualiza solo.
model SupplierProduct {
  supplierId   String    @map("supplier_id")
  productId    String    @map("product_id")
  supplierCode String?   @map("supplier_code")
  lastCost     Decimal?  @map("last_cost") @db.Decimal(12, 2)
  lastCostAt   DateTime? @map("last_cost_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by")
  updatedById  String?   @map("updated_by")
  // Borrar un proveedor sin uso borra su lista de productos.
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy    User?     @relation("SupplierProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?     @relation("SupplierProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([supplierId, productId])
  @@index([productId], map: "idx_supplier_products_product_id")
  @@map("supplier_products")
}

model Customer {
  id           String       @id @default(cuid(2))
  tradeName    String       @map("trade_name")
  legalName    String       @map("legal_name")
  cuit         String       @unique @db.VarChar(11)
  taxCondition TaxCondition @map("tax_condition")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  persons      Person[]

  @@map("customers")
}

model Person {
  id         String          @id @default(cuid(2))
  customerId String?         @map("customer_id")
  name       String
  surname    String
  mail       String          @unique
  phone      String
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(3)
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addresses  PersonAddress[]
  user       User?

  @@index([customerId], map: "idx_persons_customer_id")
  @@index([deletedAt], map: "idx_persons_deleted_at")
  @@map("persons")
}

// Provincias y localidades/partidos: las localidades son las zonas de reparto
// (los pedidos se agrupan por localidad). Tienen ABM propio.
model State {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")
  createdBy   User?    @relation("StateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("StateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  cities      City[]

  @@map("states")
}

model City {
  id          Int             @id @default(autoincrement())
  name        String
  stateId     Int             @map("state_id")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?         @map("created_by")
  updatedById String?         @map("updated_by")
  state       State           @relation(fields: [stateId], references: [id], onDelete: Restrict)
  createdBy   User?           @relation("CityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?           @relation("CityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  addresses   PersonAddress[]
  warehouses  Warehouse[]
  suppliers   Supplier[]

  @@unique([name, stateId])
  @@index([stateId], map: "idx_cities_state_id")
  @@map("cities")
}

model PersonAddress {
  id          String    @id @default(cuid(2))
  personId    String    @map("person_id")
  name        String
  description String?
  address     String
  cityId      Int       @map("city_id")
  zipCode     String?   @map("zip_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  person      Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  city        City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  sales       Sale[]

  @@index([personId], map: "idx_person_addresses_person_id")
  @@index([cityId], map: "idx_person_addresses_city_id")
  @@map("person_addresses")
}

model User {
  id                      String            @id @default(cuid(2))
  personId                String            @unique @map("person_id")
  userType                UserType          @map("user_type")
  passwordHash            String            @map("password_hash")
  passwordMustChange      Boolean           @default(true) @map("password_must_change")
  isActive                Boolean           @default(true) @map("is_active")
  // Va en el token: incrementarlo invalida las sesiones emitidas antes.
  sessionVersion          Int               @default(0) @map("session_version")
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz(3)
  person                  Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  sales                   Sale[]
  auditLogs               AuditLog[]
  measurementUnitsCreated MeasurementUnit[] @relation("MeasurementUnitCreatedBy")
  measurementUnitsUpdated MeasurementUnit[] @relation("MeasurementUnitUpdatedBy")
  categoriesCreated       Category[]        @relation("CategoryCreatedBy")
  categoriesUpdated       Category[]        @relation("CategoryUpdatedBy")
  warehousesCreated       Warehouse[]       @relation("WarehouseCreatedBy")
  warehousesUpdated       Warehouse[]       @relation("WarehouseUpdatedBy")
  taxRatesCreated         TaxRate[]         @relation("TaxRateCreatedBy")
  taxRatesUpdated         TaxRate[]         @relation("TaxRateUpdatedBy")
  productsCreated         Product[]         @relation("ProductCreatedBy")
  productsUpdated         Product[]         @relation("ProductUpdatedBy")
  stockMovements          StockMovement[]
  statesCreated           State[]           @relation("StateCreatedBy")
  statesUpdated           State[]           @relation("StateUpdatedBy")
  citiesCreated           City[]            @relation("CityCreatedBy")
  citiesUpdated           City[]            @relation("CityUpdatedBy")
  suppliersCreated        Supplier[]        @relation("SupplierCreatedBy")
  suppliersUpdated        Supplier[]        @relation("SupplierUpdatedBy")
  supplierProductsCreated SupplierProduct[] @relation("SupplierProductCreatedBy")
  supplierProductsUpdated SupplierProduct[] @relation("SupplierProductUpdatedBy")

  @@index([userType], map: "idx_users_user_type")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model Discount {
  id            String         @id @default(cuid(2))
  name          String         @unique
  description   String?
  percentage    Decimal?       @db.Decimal(5, 4)
  value         Decimal?       @db.Decimal(12, 2)
  dateFrom      DateTime?      @map("date_from") @db.Timestamptz(3)
  dateTo        DateTime?      @map("date_to") @db.Timestamptz(3)
  maxUses       Int?           @map("max_uses")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  usedDiscounts UsedDiscount[]

  @@index([dateFrom, dateTo], map: "idx_discounts_date_from_date_to")
  @@map("discounts")
}

model SaleItem {
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitWeight  Decimal  @map("unit_weight") @db.Decimal(10, 3)
  unitVolume  Decimal? @map("unit_volume") @db.Decimal(10, 3)
  unitTaxRate Decimal  @map("unit_tax_rate") @db.Decimal(5, 4)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([saleId, productId])
  @@map("sale_items")
}

model Sale {
  id            String           @id @default(cuid(2))
  userId        String           @map("user_id")
  addressId     String           @map("address_id")
  subTotal      Decimal          @map("sub_total") @db.Decimal(12, 2)
  tax           Decimal          @db.Decimal(12, 2)
  discount      Decimal          @db.Decimal(12, 2)
  total         Decimal          @db.Decimal(12, 2)
  paymentMethod PaymentMethod    @map("payment_method")
  state         SaleState        @default(PENDING)
  paymentState  SalePaymentState @default(PENDING) @map("payment_state")
  paidAt        DateTime?        @map("paid_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  address       PersonAddress    @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items         SaleItem[]
  usedDiscounts UsedDiscount[]

  @@index([userId], map: "idx_sales_user_id")
  @@index([addressId], map: "idx_sales_address_id")
  @@index([state], map: "idx_sales_state")
  @@index([createdAt], map: "idx_sales_created_at")
  @@map("sales")
}

model UsedDiscount {
  discountId String   @map("discount_id")
  saleId     String   @map("sale_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@id([discountId, saleId])
  @@index([saleId], map: "idx_used_discounts_sale_id")
  @@map("used_discounts")
}

// Registro de quién hizo qué. Solo se inserta, nunca se modifica ni se borra.
model AuditLog {
  id          String       @id @default(cuid(2))
  // Null cuando no hay sesión (p. ej. un login fallido).
  actorUserId String?      @map("actor_user_id")
  action      AuditAction
  entityType  AuditEntity? @map("entity_type")
  entityId    String?      @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?      @map("user_agent")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor_user_id_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([action, createdAt], map: "idx_audit_logs_action_created_at")
  @@map("audit_logs")
}

// Intentos de login para el bloqueo por fuerza bruta. `mail` es lo que se
// tipeó, exista o no la cuenta, así el bloqueo no revela qué mails hay.
model LoginAttempt {
  id        String   @id @default(cuid(2))
  mail      String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mail, createdAt], map: "idx_login_attempts_mail_created_at")
  @@index([mail, ip, createdAt], map: "idx_login_attempts_mail_ip_created_at")
  @@map("login_attempts")
}
