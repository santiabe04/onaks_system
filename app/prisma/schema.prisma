generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserType {
  ADMIN
  CLIENT
  /// Driver: loads the deliveries of their route sheets.
  DRIVER
}

enum TaxCondition {
  REGISTERED_TAXPAYER
  SINGLE_TAX_REGIME
  EXEMPT
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum SaleState {
  PENDING
  PREPARING
  READY_TO_SHIP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
  FINISHED
}

enum SalePaymentState {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
}

// Manual: ENTRY, ADJUSTMENT, WRITE_OFF and transfers (an OUT/IN pair).
// SALE is generated by orders (phase 4).
enum StockMovementType {
  ENTRY
  ADJUSTMENT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  /// Return to the warehouse of what an order deducted (going back to Pending or canceling).
  SALE_RETURN
  /// Entry from a purchase receiving report.
  PURCHASE_RECEIPT
  /// Reversal of the entry when the receiving report is voided.
  PURCHASE_RECEIPT_REVERSAL
  /// Entry from a customer return (credit note).
  CUSTOMER_RETURN
  /// Reversal of the entry when the return is voided.
  CUSTOMER_RETURN_REVERSAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGIN_LOCKED
  LOGOUT
  PASSWORD_CHANGE
  // The admin resets another user's password.
  PASSWORD_RESET
  // The admin releases a login lock caused by failed attempts.
  LOGIN_UNLOCK
  ACCESS_DENIED
}

enum AuditEntity {
  MEASUREMENT_UNIT
  CATEGORY
  WAREHOUSE
  TAX_RATE
  STOCK_MOVEMENT
  STATE
  CITY
  SUPPLIER
  SUPPLIER_PRODUCT
  PRODUCT
  CUSTOMER
  PERSON
  CUSTOMER_ADDRESS
  USER
  DISCOUNT
  SALE
  CUSTOMER_PAYMENT
  DRIVER
  VEHICLE
  ROUTE_SHEET
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER_INVOICE
  SUPPLIER_PAYMENT
  SUPPLIER_CREDIT_NOTE
  PICKING_LIST
  PRODUCT_LOCATION
  PRICE_LIST
  CUSTOMER_CREDIT_NOTE
  TRANSFER_SETTINGS
  TRANSFER_PROOF
  STOCK_COUNT
}

/// Status of a transfer receipt that the customer uploaded.
enum TransferProofState {
  /// Waiting for the admin to review it.
  PENDING
  /// Validated: generated a payment in the customer account.
  VALIDATED
  /// Rejected with a reason: the customer can upload another one.
  REJECTED
}

/// What a customer credit note documents.
enum CustomerCreditNoteKind {
  /// Return of goods from a delivered order (with products and stock).
  RETURN
  /// Discount or adjustment by amount, with no goods.
  ADJUSTMENT
}

/// What happens to what the customer returns.
enum ReturnDestination {
  /// Goes back to the warehouse to be sold again.
  RESTOCK
  /// Entered and written off (expired, broken).
  WRITE_OFF
}

// --- TABLES ---

model MeasurementUnit {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  description    String?
  // A fraction can be requested (kg, liters); with "u" only whole numbers.
  allowsDecimals Boolean   @default(false) @map("allows_decimals")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Null in what the seed loads.
  createdById    String?   @map("created_by")
  updatedById    String?   @map("updated_by")
  createdBy      User?     @relation("MeasurementUnitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?     @relation("MeasurementUnitUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products       Product[]

  @@map("measurement_units")
}

// Tree of up to 3 levels (the app enforces the limit). The name is unique
// among siblings, also at the root (NULLS NOT DISTINCT index in the migration).
model Category {
  id          Int        @id @default(autoincrement())
  name        String
  parentId    Int?       @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?    @map("created_by")
  updatedById String?    @map("updated_by")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  createdBy   User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([parentId, name])
  @@index([parentId], map: "idx_categories_parent_id")
  @@map("categories")
}

// Warehouses of goods, with their own stock (ProductStock). Inactive: receives no new
// movements, but is kept for the history. Only deactivated when there is no stock.
model Warehouse {
  id             String               @id @default(cuid(2))
  name           String               @unique
  address        String
  cityId         Int                  @map("city_id")
  phone          String?
  contactName    String?              @map("contact_name")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?              @map("created_by")
  updatedById    String?              @map("updated_by")
  city           City                 @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy      User?                @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?                @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  stocks         ProductStock[]
  stockMovements StockMovement[]
  lots           StockLot[]
  goodsReceipts  GoodsReceipt[]
  pickingLists   PickingList[]
  stockCounts    StockCount[]
  creditNotes    CustomerCreditNote[]

  @@index([cityId], map: "idx_warehouses_city_id")
  @@map("warehouses")
}

// VAT rates, as a fraction (0.21). Changing a rate affects all the
// products that use it; orders already placed keep the one from the time.
model TaxRate {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  rate        Decimal   @db.Decimal(5, 4)
  // Inactive: not offered for new products, but still valid for the ones using it.
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdBy   User?     @relation("TaxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("TaxRateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products    Product[]

  @@map("tax_rates")
}

model Product {
  id                String                   @id @default(cuid(2))
  name              String                   @unique
  // Internal code, required. The barcode is optional (not everything has an EAN).
  sku               String                   @unique
  barcode           String?                  @unique
  description       String?
  // Only leaf categories (no children): the app enforces it.
  categoryId        Int                      @map("category_id")
  // Net price, without VAT. The final price is calculated with the rate.
  price             Decimal                  @db.Decimal(12, 2)
  taxRateId         Int                      @map("tax_rate_id")
  measurementUnitId Int                      @map("measurement_unit_id")
  // Weight in kg and volume in liters, per sales unit.
  weight            Decimal                  @db.Decimal(10, 3)
  volume            Decimal?                 @db.Decimal(10, 3)
  /// Minimum stock: below this an alert is raised and a purchase is suggested.
  minStock          Decimal?                 @map("min_stock") @db.Decimal(12, 3)
  /// Tracks lot and expiry: on receipt they are loaded and outgoing stock takes what expires first.
  tracksExpiry      Boolean                  @default(false) @map("tracks_expiry")
  // WebP file in UPLOADS_DIR/products (see lib/product-image).
  imageFile         String?                  @map("image_file")
  // Paused: not shown in the catalog, but keeps its history and stock.
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdById       String?                  @map("created_by")
  updatedById       String?                  @map("updated_by")
  category          Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  measurementUnit   MeasurementUnit          @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  taxRate           TaxRate                  @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  createdBy         User?                    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User?                    @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  saleItems         SaleItem[]
  stocks            ProductStock[]
  suppliers         SupplierProduct[]
  cartItems         CartItem[]
  stockMovements    StockMovement[]
  purchaseItems     PurchaseOrderItem[]
  receiptItems      GoodsReceiptItem[]
  receiptLots       GoodsReceiptLot[]
  lots              StockLot[]
  pickingItems      PickingListItem[]
  countItems        StockCountItem[]
  invoiceItems      SupplierInvoiceItem[]
  priceListItems    PriceListItem[]
  creditNoteItems   CustomerCreditNoteItem[]
  favorites         CustomerFavorite[]

  @@index([categoryId], map: "idx_products_category_id")
  @@index([measurementUnitId], map: "idx_products_measurement_unit_id")
  @@index([taxRateId], map: "idx_products_tax_rate_id")
  @@index([deletedAt], map: "idx_products_deleted_at")
  @@map("products")
}

// Current balance per product and warehouse. It only changes through a
// StockMovement (in the same transaction). It can be negative.
model ProductStock {
  productId   String    @map("product_id")
  warehouseId String    @map("warehouse_id")
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  /// Location in the warehouse (aisle-shelf-level, e.g. "A-03-2"), to sort the picking.
  location    String?   @db.VarChar(30)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@index([warehouseId], map: "idx_product_stocks_warehouse_id")
  @@map("product_stocks")
}

// Movement ledger: insert-only (trigger in the DB). quantity is the
// signed change and balanceAfter the balance left in that warehouse.
model StockMovement {
  id                   String              @id @default(cuid(2))
  productId            String              @map("product_id")
  warehouseId          String              @map("warehouse_id")
  type                 StockMovementType
  quantity             Decimal             @db.Decimal(12, 3)
  balanceAfter         Decimal             @map("balance_after") @db.Decimal(12, 3)
  comment              String?
  // Groups the two legs of a transfer.
  transferId           String?             @map("transfer_id")
  /// Order that deducted or returned stock (SALE / SALE_RETURN).
  saleId               String?             @map("sale_id")
  /// Receiving report that entered or reversed stock.
  goodsReceiptId       String?             @map("goods_receipt_id")
  /// Credit note (customer return) that moved stock.
  customerCreditNoteId String?             @map("customer_credit_note_id")
  /// Lot that stock left from or went back to (products that track expiry).
  lotId                String?             @map("lot_id")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById          String?             @map("created_by")
  product              Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse            Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy            User?               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  sale                 Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  goodsReceipt         GoodsReceipt?       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  customerCreditNote   CustomerCreditNote? @relation(fields: [customerCreditNoteId], references: [id], onDelete: Restrict)
  lot                  StockLot?           @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([lotId], map: "idx_stock_movements_lot_id")
  @@index([productId, createdAt], map: "idx_stock_movements_product_id_created_at")
  @@index([saleId], map: "idx_stock_movements_sale_id")
  @@index([goodsReceiptId], map: "idx_stock_movements_goods_receipt_id")
  @@index([customerCreditNoteId], map: "idx_stock_movements_customer_credit_note_id")
  @@index([warehouseId, createdAt], map: "idx_stock_movements_warehouse_id_created_at")
  @@index([transferId], map: "idx_stock_movements_transfer_id")
  @@map("stock_movements")
}

// Suppliers. Inactive: not offered for new purchases, but kept.
// Address and city go together or not at all (the app enforces it).
model Supplier {
  id             String               @id @default(cuid(2))
  legalName      String               @map("legal_name")
  tradeName      String?              @map("trade_name")
  cuit           String               @unique @db.VarChar(11)
  taxCondition   TaxCondition         @map("tax_condition")
  contactName    String?              @map("contact_name")
  contactMail    String?              @map("contact_mail")
  contactPhone   String?              @map("contact_phone")
  address        String?
  cityId         Int?                 @map("city_id")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?              @map("created_by")
  updatedById    String?              @map("updated_by")
  city           City?                @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy      User?                @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?                @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  creditNotes    SupplierCreditNote[]

  @@index([cityId], map: "idx_suppliers_city_id")
  @@map("suppliers")
}

// Which products we buy from each supplier. The cost is net (without VAT): for
// now it is entered by hand; with purchase orders (phase 9) it updates by itself.
model SupplierProduct {
  supplierId   String    @map("supplier_id")
  productId    String    @map("product_id")
  supplierCode String?   @map("supplier_code")
  lastCost     Decimal?  @map("last_cost") @db.Decimal(12, 2)
  lastCostAt   DateTime? @map("last_cost_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by")
  updatedById  String?   @map("updated_by")
  // Deleting a supplier with no use deletes its product list.
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy    User?     @relation("SupplierProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?     @relation("SupplierProductUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([supplierId, productId])
  @@index([productId], map: "idx_supplier_products_product_id")
  @@map("supplier_products")
}

// Cart: one per person, in the DB (it is built on one device and finished on
// another). It only stores product and quantity: prices are taken when confirming.
/// A customer company's favorite product: shared by all its people. Like the
/// cart, it is a preference and not business data: it does not go to the audit log.
model CustomerFavorite {
  customerId String   @map("customer_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([productId], map: "idx_customer_favorites_product_id")
  @@map("customer_favorites")
}

model CartItem {
  personId  String   @map("person_id")
  productId String   @map("product_id")
  quantity  Decimal  @db.Decimal(12, 3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([personId, productId])
  @@index([productId], map: "idx_cart_items_product_id")
  @@map("cart_items")
}

model Customer {
  id              String               @id @default(cuid(2))
  tradeName       String               @map("trade_name")
  legalName       String               @map("legal_name")
  cuit            String               @unique @db.VarChar(11)
  taxCondition    TaxCondition         @map("tax_condition")
  /// Price list; without a list it pays the base price.
  priceListId     String?              @map("price_list_id")
  /// The customer's own discount on their list price, as a fraction (0.05 = 5 %).
  discountRate    Decimal              @default(0) @map("discount_rate") @db.Decimal(5, 4)
  /// Credit limit (debt + open orders); null = no limit.
  creditLimit     Decimal?             @map("credit_limit") @db.Decimal(12, 2)
  /// Payment term in days from delivery; null = no overdue debt control.
  paymentTermDays Int?                 @map("payment_term_days")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdById     String?              @map("created_by")
  updatedById     String?              @map("updated_by")
  createdBy       User?                @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?                @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  priceList       PriceList?           @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  persons         Person[]
  // Delivery addresses belong to the customer: any person of the customer uses them.
  addresses       CustomerAddress[]
  payments        CustomerPayment[]
  creditNotes     CustomerCreditNote[]
  favorites       CustomerFavorite[]

  @@index([deletedAt], map: "idx_customers_deleted_at")
  @@index([priceListId], map: "idx_customers_price_list_id")
  @@map("customers")
}

// Price list (pet shop, vet, wholesale): an adjustment over the
// base price of all products, with an optional fixed price per product.
model PriceList {
  id          String          @id @default(cuid(2))
  name        String          @unique @db.VarChar(60)
  /// Adjustment over the base net price, as a fraction: -0.1 = 10 % less, 0.15 = 15 % more.
  adjustment  Decimal         @db.Decimal(5, 4)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?         @map("created_by")
  updatedById String?         @map("updated_by")
  createdBy   User?           @relation("PriceListCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?           @relation("PriceListUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  items       PriceListItem[]
  customers   Customer[]

  @@map("price_lists")
}

/// Fixed net price of a product in a list: overrides the list's adjustment.
model PriceListItem {
  priceListId String    @map("price_list_id")
  productId   String    @map("product_id")
  price       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([priceListId, productId])
  @@index([productId], map: "idx_price_list_items_product_id")
  @@map("price_list_items")
}

model Person {
  id           String     @id @default(cuid(2))
  customerId   String?    @map("customer_id")
  name         String
  surname      String
  mail         String     @unique
  phone        String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdById  String?    @map("created_by")
  updatedById  String?    @map("updated_by")
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User?      @relation("PersonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?      @relation("PersonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  user         User?
  editingSales Sale[]     @relation("SaleEditingPerson")
  cartItems    CartItem[]

  @@index([customerId], map: "idx_persons_customer_id")
  @@index([deletedAt], map: "idx_persons_deleted_at")
  @@map("persons")
}

// Provinces and cities/districts: the cities are the delivery zones
// (orders are grouped by city). They have their own CRUD.
model State {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by")
  updatedById String?  @map("updated_by")
  createdBy   User?    @relation("StateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?    @relation("StateUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  cities      City[]

  @@map("states")
}

model City {
  id          Int               @id @default(autoincrement())
  name        String
  stateId     Int               @map("state_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?           @map("created_by")
  updatedById String?           @map("updated_by")
  state       State             @relation(fields: [stateId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("CityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?             @relation("CityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  addresses   CustomerAddress[]
  warehouses  Warehouse[]
  suppliers   Supplier[]

  @@unique([name, stateId])
  @@index([stateId], map: "idx_cities_state_id")
  @@map("cities")
}

// Delivery address of a customer (e.g. each branch of a pet shop). The
// city is the delivery zone. Soft delete: orders reference it.
model CustomerAddress {
  id          String    @id @default(cuid(2))
  customerId  String    @map("customer_id")
  name        String
  description String?
  address     String
  cityId      Int       @map("city_id")
  zipCode     String?   @map("zip_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  city        City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("CustomerAddressCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?     @relation("CustomerAddressUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  sales       Sale[]

  @@index([customerId], map: "idx_customer_addresses_customer_id")
  @@index([cityId], map: "idx_customer_addresses_city_id")
  @@map("customer_addresses")
}

model User {
  id                         String               @id @default(cuid(2))
  personId                   String               @unique @map("person_id")
  userType                   UserType             @map("user_type")
  passwordHash               String               @map("password_hash")
  passwordMustChange         Boolean              @default(true) @map("password_must_change")
  isActive                   Boolean              @default(true) @map("is_active")
  // It goes in the token: incrementing it invalidates the sessions issued before.
  sessionVersion             Int                  @default(0) @map("session_version")
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                  DateTime?            @map("deleted_at") @db.Timestamptz(3)
  person                     Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  sales                      Sale[]
  creditReleasedSales        Sale[]               @relation("SaleCreditReleasedBy")
  auditLogs                  AuditLog[]
  measurementUnitsCreated    MeasurementUnit[]    @relation("MeasurementUnitCreatedBy")
  measurementUnitsUpdated    MeasurementUnit[]    @relation("MeasurementUnitUpdatedBy")
  categoriesCreated          Category[]           @relation("CategoryCreatedBy")
  categoriesUpdated          Category[]           @relation("CategoryUpdatedBy")
  warehousesCreated          Warehouse[]          @relation("WarehouseCreatedBy")
  warehousesUpdated          Warehouse[]          @relation("WarehouseUpdatedBy")
  taxRatesCreated            TaxRate[]            @relation("TaxRateCreatedBy")
  taxRatesUpdated            TaxRate[]            @relation("TaxRateUpdatedBy")
  priceListsCreated          PriceList[]          @relation("PriceListCreatedBy")
  priceListsUpdated          PriceList[]          @relation("PriceListUpdatedBy")
  productsCreated            Product[]            @relation("ProductCreatedBy")
  productsUpdated            Product[]            @relation("ProductUpdatedBy")
  stockMovements             StockMovement[]
  statesCreated              State[]              @relation("StateCreatedBy")
  statesUpdated              State[]              @relation("StateUpdatedBy")
  citiesCreated              City[]               @relation("CityCreatedBy")
  citiesUpdated              City[]               @relation("CityUpdatedBy")
  suppliersCreated           Supplier[]           @relation("SupplierCreatedBy")
  suppliersUpdated           Supplier[]           @relation("SupplierUpdatedBy")
  supplierProductsCreated    SupplierProduct[]    @relation("SupplierProductCreatedBy")
  supplierProductsUpdated    SupplierProduct[]    @relation("SupplierProductUpdatedBy")
  customersCreated           Customer[]           @relation("CustomerCreatedBy")
  customersUpdated           Customer[]           @relation("CustomerUpdatedBy")
  personsCreated             Person[]             @relation("PersonCreatedBy")
  personsUpdated             Person[]             @relation("PersonUpdatedBy")
  customerAddressesCreated   CustomerAddress[]    @relation("CustomerAddressCreatedBy")
  customerAddressesUpdated   CustomerAddress[]    @relation("CustomerAddressUpdatedBy")
  paymentsCreated            CustomerPayment[]    @relation("CustomerPaymentCreatedBy")
  paymentsVoided             CustomerPayment[]    @relation("CustomerPaymentVoidedBy")
  customerCreditNotesCreated CustomerCreditNote[] @relation("CustomerCreditNoteCreatedBy")
  customerCreditNotesVoided  CustomerCreditNote[] @relation("CustomerCreditNoteVoidedBy")
  transferSettingsUpdated    TransferSettings[]
  transferProofsUploaded     TransferProof[]      @relation("TransferProofUploadedBy")
  transferProofsReviewed     TransferProof[]      @relation("TransferProofReviewedBy")
  driver                     Driver?              @relation("DriverUser")
  driversCreated             Driver[]             @relation("DriverCreatedBy")
  driversUpdated             Driver[]             @relation("DriverUpdatedBy")
  vehiclesCreated            Vehicle[]            @relation("VehicleCreatedBy")
  vehiclesUpdated            Vehicle[]            @relation("VehicleUpdatedBy")
  routeSheetsCreated         RouteSheet[]         @relation("RouteSheetCreatedBy")
  routeSheetsUpdated         RouteSheet[]         @relation("RouteSheetUpdatedBy")
  routeStopsRecorded         RouteStop[]          @relation("RouteStopRecordedBy")
  routeSheetsClosed          RouteSheet[]         @relation("RouteSheetClosedBy")
  purchaseOrdersCreated      PurchaseOrder[]      @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated      PurchaseOrder[]      @relation("PurchaseOrderUpdatedBy")
  goodsReceiptsCreated       GoodsReceipt[]       @relation("GoodsReceiptCreatedBy")
  goodsReceiptsAnnulled      GoodsReceipt[]       @relation("GoodsReceiptAnnulledBy")
  supplierInvoicesCreated    SupplierInvoice[]    @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesApproved   SupplierInvoice[]    @relation("SupplierInvoiceApprovedBy")
  supplierInvoicesAnnulled   SupplierInvoice[]    @relation("SupplierInvoiceAnnulledBy")
  supplierPaymentsCreated    SupplierPayment[]    @relation("SupplierPaymentCreatedBy")
  supplierPaymentsAnnulled   SupplierPayment[]    @relation("SupplierPaymentAnnulledBy")
  creditNotesCreated         SupplierCreditNote[] @relation("SupplierCreditNoteCreatedBy")
  creditNotesAnnulled        SupplierCreditNote[] @relation("SupplierCreditNoteAnnulledBy")
  pickingListsCreated        PickingList[]        @relation("PickingListCreatedBy")
  pickingListsConfirmed      PickingList[]        @relation("PickingListConfirmedBy")
  stockCountsCreated         StockCount[]         @relation("StockCountCreatedBy")
  stockCountsApproved        StockCount[]         @relation("StockCountApprovedBy")
  supplierAllocations        SupplierAllocation[]

  @@index([userType], map: "idx_users_user_type")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model Discount {
  id            String         @id @default(cuid(2))
  name          String         @unique
  description   String?
  percentage    Decimal?       @db.Decimal(5, 4)
  value         Decimal?       @db.Decimal(12, 2)
  dateFrom      DateTime?      @map("date_from") @db.Timestamptz(3)
  dateTo        DateTime?      @map("date_to") @db.Timestamptz(3)
  maxUses       Int?           @map("max_uses")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  usedDiscounts UsedDiscount[]

  @@index([dateFrom, dateTo], map: "idx_discounts_date_from_date_to")
  @@map("discounts")
}

model SaleItem {
  saleId        String   @map("sale_id")
  productId     String   @map("product_id")
  quantity      Decimal  @db.Decimal(12, 4)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Base net price of the product when sold; the difference with `unitPrice` is the discount.
  unitListPrice Decimal  @map("unit_list_price") @db.Decimal(12, 2)
  unitWeight    Decimal  @map("unit_weight") @db.Decimal(10, 3)
  unitVolume    Decimal? @map("unit_volume") @db.Decimal(10, 3)
  unitTaxRate   Decimal  @map("unit_tax_rate") @db.Decimal(5, 4)
  /// Last purchase cost (net) when the order was placed; null if there was none. For the margin.
  unitCost      Decimal? @map("unit_cost") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([saleId, productId])
  @@map("sale_items")
}

model Sale {
  id                 String               @id @default(cuid(2))
  /// Sequential number for the customer and the admin ("Order #12").
  number             Int                  @unique @default(autoincrement())
  userId             String               @map("user_id")
  addressId          String               @map("address_id")
  subTotal           Decimal              @map("sub_total") @db.Decimal(12, 2)
  tax                Decimal              @db.Decimal(12, 2)
  discount           Decimal              @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  paymentMethod      PaymentMethod        @map("payment_method")
  state              SaleState            @default(PENDING)
  paymentState       SalePaymentState     @default(PENDING) @map("payment_state")
  paidAt             DateTime?            @map("paid_at") @db.Timestamptz(3)
  /// When it moved to Delivered (goes back to null if reverted). Sale date for the reports.
  deliveredAt        DateTime?            @map("delivered_at") @db.Timestamptz(3)
  /// The admin allowed the customer to edit the order (used once).
  customerCanEdit    Boolean              @default(false) @map("customer_can_edit")
  /// Person who is editing it (the items went back to their cart).
  editingPersonId    String?              @map("editing_person_id")
  /// Customer comment when confirming (delivery time, etc.).
  notes              String?              @db.VarChar(500)
  /// Held for credit when confirming (over the limit or with overdue debt); null = no.
  creditHoldAt       DateTime?            @map("credit_hold_at") @db.Timestamptz(3)
  /// Why: { limit, exposure } and/or { overdueSince, termDays }.
  creditHoldReasons  Json?                @map("credit_hold_reasons")
  /// The admin approved it: it follows the normal flow.
  creditReleasedAt   DateTime?            @map("credit_released_at") @db.Timestamptz(3)
  creditReleasedById String?              @map("credit_released_by")
  creditReleaseNote  String?              @map("credit_release_note") @db.VarChar(300)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  editingPerson      Person?              @relation("SaleEditingPerson", fields: [editingPersonId], references: [id], onDelete: SetNull)
  creditReleasedBy   User?                @relation("SaleCreditReleasedBy", fields: [creditReleasedById], references: [id], onDelete: Restrict)
  address            CustomerAddress      @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  usedDiscounts      UsedDiscount[]
  stockMovements     StockMovement[]
  payments           CustomerPayment[]
  creditNotes        CustomerCreditNote[]
  transferProofs     TransferProof[]
  routeStops         RouteStop[]
  pickingItems       PickingListItem[]
  notifications      OrderNotification[]

  @@index([userId], map: "idx_sales_user_id")
  @@index([addressId], map: "idx_sales_address_id")
  @@index([state], map: "idx_sales_state")
  @@index([createdAt], map: "idx_sales_created_at")
  @@index([deliveredAt], map: "idx_sales_delivered_at")
  @@index([creditHoldAt], map: "idx_sales_credit_hold_at")
  @@map("sales")
}

model UsedDiscount {
  discountId String   @map("discount_id")
  saleId     String   @map("sale_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@id([discountId, saleId])
  @@index([saleId], map: "idx_used_discounts_sale_id")
  @@map("used_discounts")
}

// Record of who did what. Insert-only, never modified or deleted.
model AuditLog {
  id          String       @id @default(cuid(2))
  // Null when there is no session (e.g. a failed login).
  actorUserId String?      @map("actor_user_id")
  action      AuditAction
  entityType  AuditEntity? @map("entity_type")
  entityId    String?      @map("entity_id")
  before      Json?
  after       Json?
  metadata    Json?
  ip          String?
  userAgent   String?      @map("user_agent")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([actorUserId, createdAt], map: "idx_audit_logs_actor_user_id_created_at")
  @@index([entityType, entityId], map: "idx_audit_logs_entity_type_entity_id")
  @@index([action, createdAt], map: "idx_audit_logs_action_created_at")
  @@map("audit_logs")
}

// Login attempts for the brute-force lock. `mail` is what was
// typed, whether or not the account exists, so the lock does not reveal which emails exist.
model LoginAttempt {
  id        String   @id @default(cuid(2))
  mail      String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mail, createdAt], map: "idx_login_attempts_mail_created_at")
  @@index([mail, ip, createdAt], map: "idx_login_attempts_mail_ip_created_at")
  @@map("login_attempts")
}

enum CustomerPaymentKind {
  /// Payment: lowers the debt (or leaves a credit balance).
  PAYMENT
  /// Refund: giving back money from the credit balance.
  REFUND
}

/// Customer account: payments and refunds of the customer. The debt is the
/// delivered orders; payments are allocated automatically to the oldest order (lib/account).
model CustomerPayment {
  id            String              @id @default(cuid(2))
  customerId    String              @map("customer_id")
  /// Order it was entered from (reference; the allocation is automatic).
  saleId        String?             @map("sale_id")
  kind          CustomerPaymentKind
  amount        Decimal             @db.Decimal(12, 2)
  method        PaymentMethod
  paidOn        DateTime            @map("paid_on") @db.Date
  notes         String?             @db.VarChar(200)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String              @map("created_by")
  /// A badly entered payment is not deleted: it is voided with a reason.
  voidedAt      DateTime?           @map("voided_at") @db.Timestamptz(3)
  voidedById    String?             @map("voided_by")
  voidReason    String?             @map("void_reason") @db.VarChar(200)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale          Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("CustomerPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy      User?               @relation("CustomerPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  routeStop     RouteStop?
  transferProof TransferProof?

  @@index([customerId, paidOn], map: "idx_customer_payments_customer_id_paid_on")
  @@index([saleId], map: "idx_customer_payments_sale_id")
  @@map("customer_payments")
}

/// Bank transfer payment details of the distributor (a single row, id 1).
/// Without a row, paying by transfer is not offered at checkout.
model TransferSettings {
  id          Int      @id @default(1)
  bankName    String   @map("bank_name") @db.VarChar(60)
  holder      String   @db.VarChar(80)
  cuit        String   @db.VarChar(11)
  cbu         String?  @db.VarChar(22)
  alias       String?  @db.VarChar(20)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById String?  @map("updated_by")
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("transfer_settings")
}

/// Receipt of a transfer, uploaded by the customer. When the
/// admin validates it, the payment (`payment`) is recorded; if it is rejected the reason stays and the
/// customer can upload another one. It is not deleted: it stays in the order history.
model TransferProof {
  id           String             @id @default(cuid(2))
  saleId       String             @map("sale_id")
  /// File in `UPLOADS_DIR/transfers` (WebP image or PDF).
  file         String
  state        TransferProofState @default(PENDING)
  uploadedById String             @map("uploaded_by")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewedById String?            @map("reviewed_by")
  rejectReason String?            @map("reject_reason") @db.VarChar(200)
  /// The payment recorded when it was validated.
  paymentId    String?            @unique @map("payment_id")
  sale         Sale               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  uploadedBy   User               @relation("TransferProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy   User?              @relation("TransferProofReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  payment      CustomerPayment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([saleId], map: "idx_transfer_proofs_sale_id")
  @@index([state], map: "idx_transfer_proofs_state")
  @@map("transfer_proofs")
}

/// Customer credit note: lowers what they owe (it is allocated in the account as a
/// payment). A return (RETURN) comes from a delivered order and moves stock;
/// an adjustment (ADJUSTMENT) is only an amount. It is not deleted: it is voided with a reason.
model CustomerCreditNote {
  id             String                   @id @default(cuid(2))
  /// Sequential number people see ("CN #3").
  number         Int                      @unique @default(autoincrement())
  customerId     String                   @map("customer_id")
  /// Order being returned (only for returns).
  saleId         String?                  @map("sale_id")
  kind           CustomerCreditNoteKind
  /// Total credited, with VAT.
  amount         Decimal                  @db.Decimal(12, 2)
  reason         String                   @db.VarChar(300)
  /// Warehouse where the returned goods went back (only for returns).
  warehouseId    String?                  @map("warehouse_id")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String                   @map("created_by")
  voidedAt       DateTime?                @map("voided_at") @db.Timestamptz(3)
  voidedById     String?                  @map("voided_by")
  voidReason     String?                  @map("void_reason") @db.VarChar(200)
  customer       Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale           Sale?                    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  warehouse      Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy      User                     @relation("CustomerCreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy       User?                    @relation("CustomerCreditNoteVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items          CustomerCreditNoteItem[]
  stockMovements StockMovement[]

  @@index([customerId, createdAt], map: "idx_customer_credit_notes_customer_id_created_at")
  @@index([saleId], map: "idx_customer_credit_notes_sale_id")
  @@map("customer_credit_notes")
}

/// Return line: snapshot of the order's price and tax rate.
model CustomerCreditNoteItem {
  creditNoteId String             @map("credit_note_id")
  productId    String             @map("product_id")
  quantity     Decimal            @db.Decimal(12, 3)
  /// Unit net and tax rate of the order (what the customer paid).
  unitPrice    Decimal            @map("unit_price") @db.Decimal(12, 2)
  unitTaxRate  Decimal            @map("unit_tax_rate") @db.Decimal(5, 4)
  /// Purchase cost of the order, to subtract it from the margin.
  unitCost     Decimal?           @map("unit_cost") @db.Decimal(12, 2)
  destination  ReturnDestination
  creditNote   CustomerCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([creditNoteId, productId])
  @@index([productId], map: "idx_customer_credit_note_items_product_id")
  @@map("customer_credit_note_items")
}

/// Driver of the route sheets. Can be linked to a user (role
/// Driver or Admin) to load deliveries from the phone.
model Driver {
  id          String       @id @default(cuid(2))
  name        String       @unique
  phone       String?
  userId      String?      @unique @map("user_id")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by")
  updatedById String?      @map("updated_by")
  user        User?        @relation("DriverUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("DriverCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?        @relation("DriverUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  routeSheets RouteSheet[]

  @@map("drivers")
}

/// Delivery vehicle. The capacity is optional: if set, creating a route sheet
/// warns when it is exceeded.
model Vehicle {
  id             String       @id @default(cuid(2))
  name           String       @unique
  plate          String?      @unique
  capacityKg     Decimal?     @map("capacity_kg") @db.Decimal(10, 3)
  capacityLiters Decimal?     @map("capacity_liters") @db.Decimal(10, 3)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?      @map("created_by")
  updatedById    String?      @map("updated_by")
  createdBy      User?        @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User?        @relation("VehicleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  routeSheets    RouteSheet[]

  @@map("vehicles")
}

enum RouteSheetState {
  /// Preparing: stops are added, removed and sorted.
  DRAFT
  /// On the road: the orders have left (On the road) and the stops are loaded.
  OUT
  /// Closed: the driver came back and the cash was counted.
  CLOSED
}

/// Route sheet: a delivery run with a driver, a vehicle and stops in order.
model RouteSheet {
  id           String          @id @default(cuid(2))
  /// Sequential number ("Sheet #12").
  number       Int             @unique @default(autoincrement())
  /// Delivery day.
  date         DateTime        @db.Date
  driverId     String          @map("driver_id")
  vehicleId    String?         @map("vehicle_id")
  state        RouteSheetState @default(DRAFT)
  notes        String?         @db.VarChar(300)
  departedAt   DateTime?       @map("departed_at") @db.Timestamptz(3)
  closedAt     DateTime?       @map("closed_at") @db.Timestamptz(3)
  /// Cash count on closing: cash collected at the stops and what the driver handed in.
  cashExpected Decimal?        @map("cash_expected") @db.Decimal(12, 2)
  cashReceived Decimal?        @map("cash_received") @db.Decimal(12, 2)
  /// Explains the difference (shortage or surplus); required if it does not match.
  closingNotes String?         @map("closing_notes") @db.VarChar(300)
  closedById   String?         @map("closed_by")
  closedBy     User?           @relation("RouteSheetClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?         @map("created_by")
  updatedById  String?         @map("updated_by")
  driver       Driver          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy    User?           @relation("RouteSheetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?           @relation("RouteSheetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  stops        RouteStop[]

  @@index([state, date], map: "idx_route_sheets_state_date")
  @@index([driverId, date], map: "idx_route_sheets_driver_id_date")
  @@map("route_sheets")
}

/// Stop on a route sheet: one order, in visiting order.
model RouteStop {
  id                 String           @id @default(cuid(2))
  routeSheetId       String           @map("route_sheet_id")
  saleId             String           @map("sale_id")
  /// Visit order (1, 2, 3…).
  position           Int
  /// What happened at the stop (entered by the driver or an admin).
  status             RouteStopStatus  @default(PENDING)
  recordedAt         DateTime?        @map("recorded_at") @db.Timestamptz(3)
  recordedById       String?          @map("recorded_by")
  /// Name of whoever received it (with the on-screen signature).
  receiverName       String?          @map("receiver_name") @db.VarChar(80)
  receiverDni        String?          @map("receiver_dni") @db.VarChar(15)
  /// Signature drawn on screen and/or photo of the signed receipt (UPLOADS_DIR/deliveries).
  signatureFile      String?          @map("signature_file")
  photoFile          String?          @map("photo_file")
  notDeliveredReason String?          @map("not_delivered_reason") @db.VarChar(200)
  /// Phone location when the stop was loaded, if it was given.
  latitude           Decimal?         @db.Decimal(9, 6)
  longitude          Decimal?         @db.Decimal(9, 6)
  accuracyMeters     Int?             @map("accuracy_meters")
  /// Payment entered at the stop (goes to the customer's account).
  paymentId          String?          @unique @map("payment_id")
  /// Partial delivery: per product, what was ordered, what was delivered and the reason for what is missing.
  shortages          Json?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  routeSheet         RouteSheet       @relation(fields: [routeSheetId], references: [id], onDelete: Cascade)
  sale               Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  recordedBy         User?            @relation("RouteStopRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  payment            CustomerPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([routeSheetId, saleId])
  @@index([saleId], map: "idx_route_stops_sale_id")
  @@map("route_stops")
}

enum RouteStopStatus {
  PENDING
  DELIVERED
  NOT_DELIVERED
}

enum PurchaseOrderState {
  /// Being prepared: products, quantities and costs can change.
  DRAFT
  /// Sent to the supplier.
  SENT
  /// Some goods arrived (receiving reports).
  PARTIALLY_RECEIVED
  /// Everything arrived.
  RECEIVED
  /// Canceled before receiving anything.
  CANCELED
}

/// Purchase order (PO) to a supplier.
model PurchaseOrder {
  id           String              @id @default(cuid(2))
  /// Sequential number ("PO #12").
  number       Int                 @unique @default(autoincrement())
  supplierId   String              @map("supplier_id")
  state        PurchaseOrderState  @default(DRAFT)
  /// Expected delivery date (optional).
  expectedDate DateTime?           @map("expected_date") @db.Date
  notes        String?             @db.VarChar(300)
  /// Totals at the agreed costs (net + VAT of each product).
  subTotal     Decimal             @default(0) @map("sub_total") @db.Decimal(12, 2)
  tax          Decimal             @default(0) @db.Decimal(12, 2)
  total        Decimal             @default(0) @db.Decimal(12, 2)
  sentAt       DateTime?           @map("sent_at") @db.Timestamptz(3)
  canceledAt   DateTime?           @map("canceled_at") @db.Timestamptz(3)
  /// Closed with a shortage (it stays Received even though not everything arrived).
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz(3)
  closeNote    String?             @map("close_note") @db.VarChar(300)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?             @map("created_by")
  updatedById  String?             @map("updated_by")
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?               @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]
  invoices     SupplierInvoice[]

  @@index([supplierId, state], map: "idx_purchase_orders_supplier_id_state")
  @@index([state], map: "idx_purchase_orders_state")
  @@map("purchase_orders")
}

/// Product on a PO, with the agreed cost (net) and the VAT rate at the time.
model PurchaseOrderItem {
  purchaseOrderId  String        @map("purchase_order_id")
  productId        String        @map("product_id")
  quantity         Decimal       @db.Decimal(12, 3)
  unitCost         Decimal       @map("unit_cost") @db.Decimal(12, 2)
  taxRate          Decimal       @map("tax_rate") @db.Decimal(5, 4)
  /// What has been received so far (updated by the receiving reports).
  receivedQuantity Decimal       @default(0) @map("received_quantity") @db.Decimal(12, 3)
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([purchaseOrderId, productId])
  @@index([productId], map: "idx_purchase_order_items_product_id")
  @@map("purchase_order_items")
}

enum GoodsReceiptState {
  CONFIRMED
  /// Voided: the stock and what was received on the PO were reversed.
  ANNULLED
}

/// Receiving report (RR): what arrived for a PO, into a warehouse.
model GoodsReceipt {
  id              String             @id @default(cuid(2))
  /// Sequential number ("RR #8").
  number          Int                @unique @default(autoincrement())
  purchaseOrderId String             @map("purchase_order_id")
  warehouseId     String             @map("warehouse_id")
  /// Supplier's delivery note number (optional).
  deliveryNote    String?            @map("delivery_note") @db.VarChar(50)
  notes           String?            @db.VarChar(300)
  state           GoodsReceiptState  @default(CONFIRMED)
  annulledAt      DateTime?          @map("annulled_at") @db.Timestamptz(3)
  annulReason     String?            @map("annul_reason") @db.VarChar(300)
  annulledById    String?            @map("annulled_by")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById     String?            @map("created_by")
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy       User?              @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  annulledBy      User?              @relation("GoodsReceiptAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]
  lots            GoodsReceiptLot[]
  stockMovements  StockMovement[]

  @@index([purchaseOrderId], map: "idx_goods_receipts_purchase_order_id")
  @@index([warehouseId], map: "idx_goods_receipts_warehouse_id")
  @@map("goods_receipts")
}

/// Product received on an RR, with what the PO still needed at that time (for the difference).
model GoodsReceiptItem {
  goodsReceiptId String       @map("goods_receipt_id")
  productId      String       @map("product_id")
  quantity       Decimal      @db.Decimal(12, 3)
  /// Pending on the PO before this report (ordered minus already received, not negative).
  pending        Decimal      @db.Decimal(12, 3)
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([goodsReceiptId, productId])
  @@index([productId], map: "idx_goods_receipt_items_product_id")
  @@map("goods_receipt_items")
}

/// A lot of a product in a warehouse, with its expiry. The quantity is what
/// is left of it; the product's balance (`product_stocks`) can be larger if there is
/// stock with no lot (from before tracking or entered by hand).
model StockLot {
  id          String          @id @default(cuid(2))
  productId   String          @map("product_id")
  warehouseId String          @map("warehouse_id")
  lotCode     String          @map("lot_code") @db.VarChar(40)
  expiresOn   DateTime        @map("expires_on") @db.Date
  quantity    Decimal         @default(0) @db.Decimal(12, 3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements   StockMovement[]

  @@unique([productId, warehouseId, lotCode, expiresOn], map: "uq_stock_lots_product_warehouse_lot")
  @@index([expiresOn], map: "idx_stock_lots_expires_on")
  @@map("stock_lots")
}

/// How what was received of a product is split into lots (products that track
/// expiry): one report can bring several lots of the same product.
model GoodsReceiptLot {
  id             String       @id @default(cuid(2))
  goodsReceiptId String       @map("goods_receipt_id")
  productId      String       @map("product_id")
  lotCode        String       @map("lot_code") @db.VarChar(40)
  expiresOn      DateTime     @map("expires_on") @db.Date
  quantity       Decimal      @db.Decimal(12, 3)
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, productId, lotCode, expiresOn], map: "uq_goods_receipt_lots_lot")
  @@index([productId], map: "idx_goods_receipt_lots_product_id")
  @@map("goods_receipt_lots")
}

/// Letter of the supplier invoice.
enum InvoiceType {
  A
  B
  C
}

enum SupplierInvoiceState {
  /// The 3-way check found differences: it waits for an admin's approval.
  FLAGGED
  /// Ready to pay.
  APPROVED
  ANNULLED
}

/// Supplier invoice for a PO (there can be several per PO).
model SupplierInvoice {
  id              String                @id @default(cuid(2))
  purchaseOrderId String                @map("purchase_order_id")
  /// The one from the PO (for the supplier account and the duplicate-number check).
  supplierId      String                @map("supplier_id")
  type            InvoiceType
  pointOfSale     Int                   @map("point_of_sale")
  number          Int
  issueDate       DateTime              @map("issue_date") @db.Date
  dueDate         DateTime?             @map("due_date") @db.Date
  /// Net and VAT come from the lines; the perceptions are entered as amounts.
  subTotal        Decimal               @map("sub_total") @db.Decimal(12, 2)
  tax             Decimal               @db.Decimal(12, 2)
  vatPerception   Decimal               @default(0) @map("vat_perception") @db.Decimal(12, 2)
  iibbPerception  Decimal               @default(0) @map("iibb_perception") @db.Decimal(12, 2)
  otherTaxes      Decimal               @default(0) @map("other_taxes") @db.Decimal(12, 2)
  total           Decimal               @db.Decimal(12, 2)
  /// The total printed on the invoice (if it does not match the calculated one, it is a difference).
  printedTotal    Decimal               @map("printed_total") @db.Decimal(12, 2)
  /// Differences from the 3-way check when it was entered (empty if none).
  differences     Json                  @default("[]")
  notes           String?               @db.VarChar(300)
  state           SupplierInvoiceState
  approvalNote    String?               @map("approval_note") @db.VarChar(300)
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz(3)
  approvedById    String?               @map("approved_by")
  annulledAt      DateTime?             @map("annulled_at") @db.Timestamptz(3)
  annulReason     String?               @map("annul_reason") @db.VarChar(300)
  annulledById    String?               @map("annulled_by")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById     String?               @map("created_by")
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy       User?                 @relation("SupplierInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?                 @relation("SupplierInvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  annulledBy      User?                 @relation("SupplierInvoiceAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  items           SupplierInvoiceItem[]
  allocations     SupplierAllocation[]
  creditNotes     SupplierCreditNote[]

  @@index([purchaseOrderId], map: "idx_supplier_invoices_purchase_order_id")
  @@index([supplierId, type, pointOfSale, number], map: "idx_supplier_invoices_supplier_id_number")
  @@index([state], map: "idx_supplier_invoices_state")
  @@map("supplier_invoices")
}

/// Invoiced product: quantity, net cost and tax rate (the PO's).
model SupplierInvoiceItem {
  invoiceId String          @map("invoice_id")
  productId String          @map("product_id")
  quantity  Decimal         @db.Decimal(12, 3)
  unitCost  Decimal         @map("unit_cost") @db.Decimal(12, 2)
  taxRate   Decimal         @map("tax_rate") @db.Decimal(5, 4)
  invoice   SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([invoiceId, productId])
  @@index([productId], map: "idx_supplier_invoice_items_product_id")
  @@map("supplier_invoice_items")
}

enum SupplierPaymentMethod {
  CASH
  TRANSFER
  CHECK
  /// Withholding (VAT, IIBB, income tax): settles a debt without any money leaving.
  WITHHOLDING
}

enum WithholdingType {
  VAT
  IIBB
  INCOME
}

/// Payment order (PO) to a supplier: one or more methods, allocated to invoices.
model SupplierPayment {
  id           String                @id @default(cuid(2))
  /// Sequential number ("PmtOrd #4").
  number       Int                   @unique @default(autoincrement())
  supplierId   String                @map("supplier_id")
  paidOn       DateTime              @map("paid_on") @db.Date
  /// Sum of the methods.
  total        Decimal               @db.Decimal(12, 2)
  notes        String?               @db.VarChar(300)
  annulledAt   DateTime?             @map("annulled_at") @db.Timestamptz(3)
  annulReason  String?               @map("annul_reason") @db.VarChar(300)
  annulledById String?               @map("annulled_by")
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?               @map("created_by")
  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User?                 @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  annulledBy   User?                 @relation("SupplierPaymentAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  lines        SupplierPaymentLine[]
  allocations  SupplierAllocation[]

  @@index([supplierId, paidOn], map: "idx_supplier_payments_supplier_id_paid_on")
  @@map("supplier_payments")
}

/// One payment method of the payment order.
model SupplierPaymentLine {
  id              String                @id @default(cuid(2))
  paymentId       String                @map("payment_id")
  method          SupplierPaymentMethod
  amount          Decimal               @db.Decimal(12, 2)
  /// Transfer: operation number; check: check number; withholding: certificate.
  reference       String?               @db.VarChar(50)
  /// Check: bank.
  bank            String?               @db.VarChar(80)
  /// Check: payment date (deferred).
  dueDate         DateTime?             @map("due_date") @db.Date
  withholdingType WithholdingType?      @map("withholding_type")
  payment         SupplierPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId], map: "idx_supplier_payment_lines_payment_id")
  @@map("supplier_payment_lines")
}

/// Supplier credit note (for an amount), optionally of an invoice.
model SupplierCreditNote {
  id           String               @id @default(cuid(2))
  supplierId   String               @map("supplier_id")
  invoiceId    String?              @map("invoice_id")
  type         InvoiceType
  pointOfSale  Int                  @map("point_of_sale")
  number       Int
  issueDate    DateTime             @map("issue_date") @db.Date
  subTotal     Decimal              @map("sub_total") @db.Decimal(12, 2)
  tax          Decimal              @db.Decimal(12, 2)
  total        Decimal              @db.Decimal(12, 2)
  notes        String?              @db.VarChar(300)
  annulledAt   DateTime?            @map("annulled_at") @db.Timestamptz(3)
  annulReason  String?              @map("annul_reason") @db.VarChar(300)
  annulledById String?              @map("annulled_by")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?              @map("created_by")
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoice      SupplierInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy    User?                @relation("SupplierCreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  annulledBy   User?                @relation("SupplierCreditNoteAnnulledBy", fields: [annulledById], references: [id], onDelete: Restrict)
  allocations  SupplierAllocation[]

  @@index([supplierId, type, pointOfSale, number], map: "idx_supplier_credit_notes_supplier_id_number")
  @@index([invoiceId], map: "idx_supplier_credit_notes_invoice_id")
  @@map("supplier_credit_notes")
}

/// Allocation of a payment order or credit note to an invoice. If the voucher
/// is voided, it stops counting (the row stays).
model SupplierAllocation {
  id           String              @id @default(cuid(2))
  invoiceId    String              @map("invoice_id")
  paymentId    String?             @map("payment_id")
  creditNoteId String?             @map("credit_note_id")
  amount       Decimal             @db.Decimal(12, 2)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?             @map("created_by")
  invoice      SupplierInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment      SupplierPayment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creditNote   SupplierCreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([invoiceId], map: "idx_supplier_allocations_invoice_id")
  @@index([paymentId], map: "idx_supplier_allocations_payment_id")
  @@index([creditNoteId], map: "idx_supplier_allocations_credit_note_id")
  @@map("supplier_allocations")
}

/// Status of a warehouse inventory count.
enum StockCountState {
  /// The counts are being loaded.
  OPEN
  /// Approved: the differences were recorded as stock adjustments.
  APPROVED
  /// Discarded: it did not move stock.
  CANCELED
}

/// Status of an email notice to the customer.
enum NotificationStatus {
  /// In the queue (or failed and will be retried).
  PENDING
  SENT
  /// Attempts exhausted: the admin can retry.
  FAILED
}

enum PickingListState {
  /// The orders are In preparation and the goods are being pulled.
  OPEN
  /// Confirmed: the orders moved to Ready to ship.
  PREPARED
  /// Voided: the orders went back to Pending.
  CANCELED
}

/// Picking list: what to take from a warehouse to prepare orders.
model PickingList {
  id            String            @id @default(cuid(2))
  /// Sequential number ("Picking #5").
  number        Int               @unique @default(autoincrement())
  warehouseId   String            @map("warehouse_id")
  state         PickingListState  @default(OPEN)
  notes         String?           @db.VarChar(300)
  /// Who prepared it (may have no user).
  preparer      String?           @db.VarChar(80)
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  confirmedById String?           @map("confirmed_by")
  canceledAt    DateTime?         @map("canceled_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String?           @map("created_by")
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy     User?             @relation("PickingListCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy   User?             @relation("PickingListConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  items         PickingListItem[]

  @@index([state], map: "idx_picking_lists_state")
  @@map("picking_lists")
}

/// A product of an order on the list: what was ordered and, on confirmation, what was prepared.
model PickingListItem {
  pickingListId  String      @map("picking_list_id")
  saleId         String      @map("sale_id")
  productId      String      @map("product_id")
  quantity       Decimal     @db.Decimal(12, 3)
  /// What was taken (null until confirmed).
  picked         Decimal?    @db.Decimal(12, 3)
  /// If something was missing: MISSING (none there) or WRITTEN_OFF (broken or expired).
  shortageReason String?     @map("shortage_reason") @db.VarChar(20)
  pickingList    PickingList @relation(fields: [pickingListId], references: [id], onDelete: Cascade)
  sale           Sale        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([pickingListId, saleId, productId])
  @@index([saleId], map: "idx_picking_list_items_sale_id")
  @@index([productId], map: "idx_picking_list_items_product_id")
  @@map("picking_list_items")
}

/// Inventory count of a warehouse (entered from the phone, blind).
model StockCount {
  id           String           @id @default(cuid(2))
  /// Sequential number ("Count #3").
  number       Int              @unique @default(autoincrement())
  warehouseId  String           @map("warehouse_id")
  state        StockCountState  @default(OPEN)
  notes        String?          @db.VarChar(300)
  approvedAt   DateTime?        @map("approved_at") @db.Timestamptz(3)
  approvedById String?          @map("approved_by")
  canceledAt   DateTime?        @map("canceled_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?          @map("created_by")
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items        StockCountItem[]

  @@index([state], map: "idx_stock_counts_state")
  @@index([warehouseId], map: "idx_stock_counts_warehouse_id")
  @@map("stock_counts")
}

/// Counted quantity of a product and the balance there was when first counted.
model StockCountItem {
  stockCountId String     @map("stock_count_id")
  productId    String     @map("product_id")
  counted      Decimal    @db.Decimal(12, 3)
  /// System balance at the first scan: the difference is counted − expected,
  /// so what moved after counting is not overwritten.
  expected     Decimal    @db.Decimal(12, 3)
  /// Difference recorded on approval (null until then).
  applied      Decimal?   @db.Decimal(12, 3)
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([stockCountId, productId])
  @@index([productId], map: "idx_stock_count_items_product_id")
  @@map("stock_count_items")
}

/// Email notice to the customer about a status change of their order (queue + record).
model OrderNotification {
  id        String             @id @default(cuid(2))
  saleId    String             @map("sale_id")
  /// Status the order moved to; one notice per order and status.
  event     SaleState
  toMail    String             @map("to_mail")
  subject   String             @db.VarChar(200)
  body      String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  /// When it was picked up for sending (if it got stuck, it is picked up again).
  claimedAt DateTime?          @map("claimed_at") @db.Timestamptz(3)
  lastError String?            @map("last_error") @db.VarChar(300)
  sentAt    DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  sale      Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, event])
  @@index([status], map: "idx_order_notifications_status")
  @@map("order_notifications")
}
